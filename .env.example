# Terraform providers read credentials from the environment. Never commit real values.
# OCI (or use ~/.oci/config)
OCI_CLI_TENANCY=ocid1.tenancy.oc1..exampleuniqueid
OCI_CLI_USER=ocid1.user.oc1..exampleuniqueid
OCI_CLI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_CLI_KEY_FILE=/path/to/oci_api_key.pem
OCI_CLI_REGION=us-ashburn-1
# Cloudflare
CLOUDFLARE_API_TOKEN=replace-me
# AWS / Azure / GCP: prefer short-lived credentials (OIDC, az login, gcloud auth), not static keys.
